{
  "name": "office-mgmt-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ./node_modules/vite/bin/vite.js --port 5173",
    "dev:admin": "VITE_BACKEND_TARGET=http://localhost:4001 node ./node_modules/vite/bin/vite.js --port 5174",
    "build": "VITE_APP_TARGET=public node ./node_modules/vite/bin/vite.js build",
    "build:admin": "VITE_APP_TARGET=admin node ./node_modules/vite/bin/vite.js build",
    "build:all": "VITE_APP_TARGET=all node ./node_modules/vite/bin/vite.js build",
    "preview": "node ./node_modules/vite/bin/vite.js preview --port 4173"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "vite": "^8.2.2"
  }
}
