# Copy to .env (or let ./setup.sh --docker generate it). Never commit .env.
# Used by docker-compose.yml only; local non-docker dev uses backend/.env.

# Postgres (compose service `db`)
POSTGRES_USER=office_mgmt
POSTGRES_PASSWORD=change-me-to-a-long-random-string
POSTGRES_DB=office_mgmt_final

# Auth: 64+ hex chars (32 bytes). REQUIRED — auth refuses to issue tokens without it.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=change-me-to-64-hex-chars-minimum-00000000000000000000000000000000

# First-admin bootstrap only: POST /api/admin/bootstrap {email,password,setupToken}
# against the admin API, then REMOVE it (empty = disabled).
SETUP_TOKEN=

# Cookies: false behind plain HTTP (local compose); true when a TLS proxy
# (ALB / CloudFront / Caddy) terminates HTTPS in front.
COOKIE_SECURE=false

# Host ports (change if busy)
PUBLIC_API_PORT=4000
ADMIN_API_PORT=4001
PORTAL_PORT=8080
ADMIN_PORTAL_PORT=8081
