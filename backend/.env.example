# Copy to .env and fill in (never commit .env)
PORT=4000
# Admin back-office API port (ADMIN_MODE=admin listens here)
ADMIN_PORT=4001
# Service split: public = employee app (no /api/admin routes, they 404);
# admin = back-office only (/api/auth + /api/admin); all = everything (tests).
ADMIN_MODE=all
# Option A: single URL (Render / Railway Postgres provides this)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/office_mgmt_final
# Option B: discrete vars (local disposable cluster per AGENT.md)
# PGHOST=/tmp/opencode
# PGPORT=5434
# PGUSER=postgres
# PGDATABASE=office_mgmt_final
# Admin panel: one-time bootstrap token to create the first admin credential
# (POST /api/admin/bootstrap). Unset/remove after first use.
SETUP_TOKEN=change-me-to-a-long-random-string
# Encrypted JWT (JWE A256GCM) secret: 64+ hex chars (32 bytes). REQUIRED in
# production; auth endpoints refuse to issue tokens without it.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=change-me-to-64-hex-chars-minimum-00000000000000000000000000000000
