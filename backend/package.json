{
  "name": "office-mgmt-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "start:public": "ADMIN_MODE=public node src/index.js",
    "start:admin": "ADMIN_MODE=admin node src/index.js",
    "dev": "node --watch src/index.js",
    "dev:public": "ADMIN_MODE=public node --watch src/index.js",
    "dev:admin": "ADMIN_MODE=admin node --watch src/index.js",
    "migrate": "node src/migrate.js",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jose": "^5.10.0",
    "pg": "^8.12.0"
  },
  "overrides": {
    "qs": "^6.16.0"
  }
}
